# Dependencies
node_modules/

# npm lockfile (project uses pnpm)
package-lock.json

# Build output
dist/

# Environment files
.env
.env.*
!.env.example
*.local

# Test coverage and reports
coverage/
coverage-playwright/
playwright-report/
test-results/
# Playwright's per-shard blob reports. CI writes these and uploads them as artifacts for the
# merge job, and a local sharded run writes them too. One got committed on 2026-11-14, which
# meant the shard jobs uploaded a stale report from a developer machine along with their own
# and the merged HTML showed results that never ran in CI.
blob-report/
.nyc_output/

# Debug logs
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# Secrets / certs
*.pem
*.key
*.crt
*.p12
*.pfx

# Auth0 export config (contains client secret)
scripts/auth0-export-config.json

# Misc
.tmp/
.cache/
0
